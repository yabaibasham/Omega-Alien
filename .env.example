# ---- Omega Alien Engine 1.6.0 -------------------------------------------
# Copy to .env for local runs. On Render/Railway, enter these in the dashboard.

# Required. Long random string. Unlocks the operator console at /#/operator
# and every API route that is not public. Without it the console stays locked.
OPERATOR_KEY=

# Token. Leave OMEGA_MINT empty until the coin exists on pump.fun; the public
# site then runs in pre-launch mode. Paste the mint and restart to go live.
OMEGA_MINT=
OMEGA_TICKER=OMEGA
OMEGA_NAME=Omega Alien
# ISO time with timezone, e.g. 2026-10-24T19:00:00+11:00 (shows a countdown)
OMEGA_LAUNCH_TIME=
TREASURY_WALLET=HTN1fvHwbzKiMwh9YXZEe3eooiMdoCAs3TweWdiSZV5i
OMEGA_X_URL=https://x.com/omegaalienmeme
OMEGA_TELEGRAM_URL=https://t.me/omegaalienmeme

# RPC. Use a dedicated provider (Helius, Triton, QuickNode). The public RPC
# rate-limits the holder count and curve reads.
SOLANA_MAINNET_RPC=
SOLANA_DEVNET_RPC=https://api.devnet.solana.com

# Safety switches. Keep both false for the release.
ALLOW_MAINNET_ACTIONS=false
ENABLE_SIMULATION=false

# Your deployed origin(s), comma-separated, e.g. https://omegaalien.xyz
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=300

# Optional
GEMINI_API_KEY=
SOL_RECIPIENT=HTN1fvHwbzKiMwh9YXZEe3eooiMdoCAs3TweWdiSZV5i
# Never commit a real key. Only needed for server-signed operator actions.
OPERATOR_PRIVATE_KEY=
TRANSACTION_CONFIRM_TIMEOUT_MS=60000
TRANSACTION_MAX_ATTEMPTS=3
